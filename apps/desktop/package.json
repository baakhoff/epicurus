{
  "name": "epicurus-desktop",
  "productName": "Epicurus",
  "private": true,
  "version": "0.1.0",
  "description": "The epicurus desktop app: a native window around a server's web UI.",
  "author": "NikolaI Baakh <a@baakhoff.com>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/baakhoff/epicurus",
  "main": "dist/main/main.js",
  "desktopName": "epicurus.desktop",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "smoke": "playwright test",
    "package": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
